{
  "title": "reveal-mcp Showcase",
  "settings": {
    "theme": "black",
    "transition": "convex",
    "slideNumber": "c/t",
    "customCss": ".reveal .slides { text-align: left; } .reveal h1, .reveal h2 { text-transform: none; } .reveal .layout-title, .reveal .layout-section { text-align: center; }"
  },
  "slides": [
    {
      "layout": "title",
      "title": "<span class=\"anim-gradient-text\">Slides at the speed of thought</span>",
      "subtitle": "<span class=\"anim-fade-up\" style=\"--delay:.4s\">Generated by an AI agent with reveal-mcp</span>",
      "background": {
        "gradient": "radial-gradient(circle at 30% 20%, #2b1055, #0b0b1a 70%)"
      },
      "notes": "Welcome. Everything you see was produced from a single tool call."
    },
    {
      "title": "Why this deck exists",
      "content": "- Write slides in **Markdown** or HTML\n- Animate with fragments and *auto-animate*\n- Export to one offline HTML file or a PDF\n- Works in Claude and Codex",
      "listFragments": "fade-up",
      "notes": "Each bullet appears on its own."
    },
    {
      "layout": "section",
      "title": "Motion",
      "subtitle": "transitions, fragments, magic move",
      "background": {
        "gradient": "linear-gradient(135deg, #667eea, #764ba2)"
      },
      "transition": "zoom"
    },
    {
      "autoAnimate": true,
      "format": "html",
      "title": "Auto-animate",
      "content": "<div class=\"r-hstack\" style=\"gap:24px\"><div data-id=\"a\" style=\"width:80px;height:80px;background:#ff6b6b;border-radius:8px\"></div><div data-id=\"b\" style=\"width:80px;height:80px;background:#48dbfb;border-radius:8px\"></div></div>"
    },
    {
      "autoAnimate": true,
      "format": "html",
      "title": "Auto-animate",
      "content": "<div class=\"r-hstack\" style=\"gap:24px\"><div data-id=\"b\" style=\"width:260px;height:160px;background:#48dbfb;border-radius:80px\"></div><div data-id=\"a\" style=\"width:160px;height:160px;background:#feca57;border-radius:50%\"></div></div>"
    },
    {
      "title": "Code that walks itself",
      "code": {
        "language": "ts",
        "lineNumbers": "|1|2-4|5",
        "code": "const deck = await mcp.call('create_presentation', {\n  title: 'Q3 Review',\n  theme: 'night',\n  slides,\n});\nconsole.log(deck.htmlPath); // a < b && c > d"
      }
    },
    {
      "title": "Side by side",
      "layout": "columns",
      "columns": [
        "### Before\n- Hand-written HTML\n- Copy/paste themes",
        "### After\n- One prompt\n- <span class=\"fragment highlight-green\">Polished deck</span>"
      ],
      "verticalSlides": [
        {
          "title": "Going deeper",
          "content": "Math works too: $$ e^{i\\pi} + 1 = 0 $$"
        }
      ]
    },
    {
      "layout": "center",
      "format": "html",
      "content": "<h2 class=\"anim-bounce-in\">Built-in motion classes</h2><ul class=\"anim-stagger\" style=\"display:inline-block\"><li>anim-fade-up</li><li>anim-zoom-in</li><li>anim-float</li><li>anim-typewriter</li></ul><p class=\"anim-float\" style=\"font-size:2em\">🚀</p>"
    },
    {
      "layout": "title",
      "title": "<span class=\"anim-typewriter\" style=\"--steps:10\">Thank you</span>",
      "background": {
        "color": "#111"
      }
    }
  ]
}