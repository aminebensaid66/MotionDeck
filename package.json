{
  "name": "motiondeck",
  "version": "0.3.0",
  "description": "MCP server for Claude, Codex and any MCP client: designed, animated presentations (built on reveal.js) exported to HTML, PDF, MP4, WebM or GIF.",
  "type": "module",
  "bin": {
    "motiondeck": "dist/index.js"
  },
  "main": "dist/server.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsc --watch",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run build",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "presentation",
    "slides",
    "motion",
    "animation",
    "video",
    "reveal.js",
    "claude",
    "codex"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "marked": "^18.1.0",
    "puppeteer-core": "^25.12.0",
    "reveal.js": "^6.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aminebensaid66/MotionDeck.git"
  },
  "homepage": "https://github.com/aminebensaid66/MotionDeck#readme",
  "bugs": {
    "url": "https://github.com/aminebensaid66/MotionDeck/issues"
  },
  "author": "Amine Ben Said"
}
